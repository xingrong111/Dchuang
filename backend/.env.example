# ============================================================
# 智绘锡承 - 后端环境变量模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 严禁将真实 .env 提交到 Git（已加入 .gitignore）
# ============================================================

# --- Flask 应用 ---
FLASK_ENV=development
FLASK_DEBUG=1
# 后端服务端口（前端 Vite 代理指向 localhost:8000）
PORT=8000
SECRET_KEY=change-me-to-a-long-random-string

# --- MySQL 数据库（阶段2 使用；本机未装 MySQL 时可不填，测试用 SQLite） ---
# 推荐使用完整连接串（优先级最高）
DATABASE_URL=mysql+pymysql://nih_dev:YourPassword123@localhost:3306/nih_platform?charset=utf8mb4
# 或拆分填写（DATABASE_URL 未设置时生效）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nih_platform
DB_USER=nih_dev
DB_PASSWORD=YourPassword123

# --- Redis 缓存（阶段3 起使用，本阶段预留） ---
REDIS_URL=redis://localhost:6379/0

# --- JWT（阶段3 实现，本阶段仅预留，勿填真实密钥） ---
JWT_SECRET_KEY=change-me-before-enabling-jwt

# --- 大模型 API（阶段6-9 使用） ---
# AI Provider: mock | hunyuan | glm（默认 mock，用于开发/测试/演示；指定真实 Provider 需先提供 Key）
AI_PROVIDER=mock
TENCENT_HUNYUAN_API_KEY=
TENCENT_HUNYUAN_SECRET_KEY=
TENCENT_HUNYUAN_BASE_URL=https://hunyuan.tencent.com/api/v1
# 腾讯混元生3D（AI3D 产品，阶段12-B）: 真实凭据仅填 .env，严禁提交
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_HUNYUAN_REGION=ap-guangzhou
TENCENT_HUNYUAN_ENDPOINT=
HUNYUAN_3D_MODEL=
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v-flash
GLM_TIMEOUT=30
GLM_MAX_IMAGE_SIZE=10485760

# --- 区块链（阶段10 使用，本阶段仅预留） ---
TENCENT_TBAAS_API_KEY=
TENCENT_TBAAS_BASE_URL=

# --- CORS ---
CORS_ORIGINS=*
