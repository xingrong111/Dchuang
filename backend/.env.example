# ============================================================
# 智绘锡承 - 后端环境变量模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 严禁将真实 .env 提交到 Git（已加入 .gitignore）
# ============================================================

# --- Flask 应用 ---
# run.py 通过 FLASK_CONFIG 选择配置；生产环境必须显式设为 production
FLASK_CONFIG=production
# 可选应用元数据
APP_NAME=智绘锡承
APP_VERSION=1.0.0
API_VERSION=v1
# run.py 目前固定监听 0.0.0.0，PORT 可配置
PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# --- MySQL 数据库 ---
# 生产 ProductionConfig 必须显式提供 DATABASE_URL
DATABASE_URL=mysql+pymysql://nih_dev:YourPassword123@localhost:3306/nih_platform?charset=utf8mb4
# DB_* 仅在 development/default 且 DATABASE_URL 未设置时作为 fallback
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nih_platform
DB_USER=nih_dev
DB_PASSWORD=YourPassword123
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# --- Redis 缓存（阶段3 起使用，本阶段预留） ---
REDIS_URL=redis://localhost:6379/0
RATELIMIT_DEFAULT=100 per minute

# --- Session Cookie ---
SESSION_COOKIE_SAMESITE=Lax

# --- 大模型 API（阶段6-9 使用） ---
# AI Provider: mock | hunyuan | glm（默认 mock，用于开发/测试/演示；指定真实 Provider 需先提供 Key）
AI_PROVIDER=mock
# 历史兼容字段：当前 AI3D SDK 不使用，新部署保持留空即可
TENCENT_HUNYUAN_API_KEY=
TENCENT_HUNYUAN_SECRET_KEY=
TENCENT_HUNYUAN_BASE_URL=https://hunyuan.tencent.com/api/v1
# 腾讯混元生3D（AI3D 产品，阶段12-B）: 真实凭据仅填 .env，严禁提交
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_HUNYUAN_REGION=ap-guangzhou
TENCENT_HUNYUAN_ENDPOINT=
HUNYUAN_3D_MODEL=
# AI 异步任务超时（秒，默认 1800=30 分钟）
AI_TASK_TIMEOUT_SECONDS=1800
# AI 积分消耗（平台积分，阶段15-B）
AI_COST_3D_GENERATE=20
AI_COST_STYLE_ANALYZE=5
# AI 后台任务 Worker（阶段15-C: 默认关闭；开启后自动推进 RUNNING 任务）
AI_WORKER_ENABLED=false
AI_WORKER_INTERVAL_SECONDS=30
# 后台管理员用户 ID（阶段16-A: 配置式逗号分隔，如 '1,2'；不新增角色字段）
ADMIN_USER_IDS=
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4v-flash
GLM_TIMEOUT=30
GLM_MAX_IMAGE_SIZE=10485760

# --- 区块链（阶段10 使用，本阶段仅预留） ---
TENCENT_TBAAS_API_KEY=
TENCENT_TBAAS_BASE_URL=

# --- CORS ---
# 生产环境填前端实际 Origin；多个 Origin 使用英文逗号分隔
CORS_ORIGINS=https://frontend.example.com
